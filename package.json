{
  "name": "ige2a-csms-next",
  "version": "0.1.0",
  "private": true,
  "description": "IGE2A CSMS Next Generation - CSMS OCPP 1.6J com observabilidade completa, monitoramento de heartbeat e auditoria de comunicacao em tempo real.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "client": "tsx scripts/ocpp-simulator.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@supabase/supabase-js": "^2.86.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "prom-client": "^15.1.3",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
