# =============================================================================
# IGE2A CSMS Next Generation - variaveis de ambiente
# Copie para `.env` e ajuste. Nunca versione o `.env` (ja ignorado pelo git).
# =============================================================================

# --- Servidor HTTP / API -----------------------------------------------------
NODE_ENV=development
PORT=3100
# 0.0.0.0 aceita conexoes dos carregadores na rede local.
# Use 127.0.0.1 apenas quando houver proxy reverso na mesma maquina (producao).
HOST=0.0.0.0
LOG_LEVEL=info
# Fuso do processo: define o horario LOCAL de registro (`observedAtLocal`, com
# offset explicito) gravado na API e na persistencia. Fixar aqui torna o
# horario deterministico, sem depender do fuso do sistema operacional.
# Os campos ISO (`observedAt`) permanecem em UTC e nao sao afetados.
TZ=America/Sao_Paulo

# Chave exigida no header `x-api-key` das rotas /api/* e do canal /ws/monitor.
# Deixe vazio para desabilitar a checagem (apenas em desenvolvimento).
CSMS_API_KEY=

# --- OCPP 1.6J ---------------------------------------------------------------
# Eco do subprotocolo oferecido mesmo quando nao e exatamente `ocpp1.6`
# (necessario para variantes como `socpp1.6`). true = mais tolerante.
OCPP_LENIENT_PROTOCOL_FALLBACK=true
# Intervalo de Heartbeat sugerido quando o carregador nao negocia um valor.
OCPP_DEFAULT_HEARTBEAT_INTERVAL_SECONDS=60
# Sem nenhuma mensagem nesse periodo o socket e considerado morto (watchdog).
# Default calibrado para ~3x o intervalo de heartbeat (60 s).
OCPP_WATCHDOG_TIMEOUT_MS=180000
# Keepalive WebSocket (ping/pong) para detectar sockets zumbis.
OCPP_WS_PING_INTERVAL_MS=25000
OCPP_WS_PONG_TIMEOUT_MS=10000
# Tamanho maximo de um frame OCPP aceito.
OCPP_MAX_MESSAGE_BYTES=262144
# Faixas de classificacao do monitor de heartbeat (spec §4):
#   NORMAL   <= intervalo + tolerancia
#   ATRASADO <= intervalo + tolerancia + critico
#   CRITICO  acima disso (OFFLINE so depende do estado da conexao)
OCPP_HEARTBEAT_TOLERANCE_SECONDS=15
OCPP_HEARTBEAT_CRITICAL_SECONDS=120
# Dispara TriggerMessage no carregador em ciclo (Heartbeat, StatusNotification,
# MeterValues). NotImplemented e memorizado somente para a sessao WebSocket atual.
OCPP_STATUS_PROBE_ENABLED=true
OCPP_STATUS_PROBE_INTERVAL_MS=60000
OCPP_STATUS_PROBE_TIMEOUT_MS=5000
# Opcional: restringe StatusNotification/MeterValues a um connectorId específico.
# Vazio omite o campo e deixa a seleção a cargo do carregador.
OCPP_STATUS_PROBE_CONNECTOR_ID=

# --- Frota conhecida / reconexao ---------------------------------------------
# Registro de identidade dos carregadores ja vistos, para reconhecer a
# reconexao apos restart (em vez de tratar como novo) e sinalizar
# "aguardando reconexao" (ver docs/ANALISE_RECONEXAO_AUTOMATICA_APOS_RESTART.md).
OCPP_FLEET_ENABLED=true
# Arquivo JSON opcional com a frota esperada (formato: ["CP-1"] ou
# [{"chargePointId":"CP-1"}]). Vazio desabilita a fonte local.
OCPP_FLEET_FILE=
# Janela de tolerancia = (intervalo negociado x multiplicador) + tolerancia(s).
OCPP_RECONNECTION_GRACE_MULTIPLIER=2
OCPP_RECONNECTION_TOLERANCE_SECONDS=30
# Periodo de reavaliacao do ReconnectionWatcher.
OCPP_RECONNECTION_CHECK_INTERVAL_MS=15000

# --- Persistencia (Supabase / schema `orchestrator`) -------------------------
# Sem estas duas variaveis a persistencia fica desabilitada e o CSMS opera
# apenas em memoria. Falha de gravacao nunca interrompe o OCPP (spec §6).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=orchestrator
OCPP_LOG_PERSIST_ENABLED=true
OCPP_LOG_BATCH_SIZE=200
OCPP_LOG_FLUSH_INTERVAL_MS=1500
OCPP_LOG_MAX_QUEUE=20000
